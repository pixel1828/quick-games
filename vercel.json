{
  "routes": [
    {
      "src": "/(.*)\\.wasm\\.unityweb",
      "headers": {
        "Content-Type": "application/wasm",
        "Content-Encoding": "gzip"
      },
      "dest": "/$1.wasm.unityweb"
    },
    {
      "src": "/(.*)\\.js\\.unityweb",
      "headers": {
        "Content-Type": "application/javascript",
        "Content-Encoding": "gzip"
      },
      "dest": "/$1.js.unityweb"
    },
    {
      "src": "/(.*)\\.data\\.unityweb",
      "headers": {
        "Content-Type": "application/octet-stream",
        "Content-Encoding": "gzip"
      },
      "dest": "/$1.data.unityweb"
    }
  ]
}

